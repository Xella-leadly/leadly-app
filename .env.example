# Copy this file to .env and fill in your Supabase project credentials.
# Find them in your Supabase dashboard: Project Settings → API
#   - VITE_SUPABASE_URL  = the "Project URL" field
#   - VITE_SUPABASE_ANON_KEY = the "anon public" key (NOT the service_role key)

VITE_SUPABASE_URL=replace-with-your-project-url
VITE_SUPABASE_ANON_KEY=replace-with-your-anon-public-key
